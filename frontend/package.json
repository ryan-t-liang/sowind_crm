{
  "name": "sowind-consumer-aftersales-h5",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:gp": "vite --mode gp --host 127.0.0.1",
    "dev:un": "vite --mode un --host 127.0.0.1",
    "build": "npm run build:gp && npm run build:un",
    "build:gp": "tsc -b && vite build --mode gp && node scripts/standalone-entry.mjs dist-gp gp.html && node scripts/prune-public-assets.mjs dist-gp",
    "build:un": "tsc -b && vite build --mode un && node scripts/standalone-entry.mjs dist-un un.html && node scripts/prune-public-assets.mjs dist-un"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
